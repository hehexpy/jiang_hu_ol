<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#A7D4B2</item>
        <item name="android:windowBackground">#101B19</item>
        <item name="android:textColorPrimary">#F0EDE4</item>
        <item name="android:textColorSecondary">#AEBFB3</item>
        <item name="android:alertDialogTheme">@style/HelperDialog</item>
    </style>
    <style name="HelperDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">#1B2926</item>
        <item name="android:colorBackgroundFloating">#1B2926</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#A7D4B2</item>
        <item name="android:colorControlNormal">#698278</item>
        <item name="android:colorControlActivated">#A7D4B2</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.65</item>
        <item name="android:textColorPrimary">#F0EDE4</item>
        <item name="android:textColorSecondary">#AEBFB3</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DialogPrimaryButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DialogSecondaryButton</item>
    </style>
    <style name="DialogPrimaryButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#A7D4B2</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="DialogSecondaryButton" parent="DialogPrimaryButton">
        <item name="android:textColor">#AEBFB3</item>
    </style>
</resources>
