<?xml version="1.0" encoding="utf-8"?>
<!-- 视觉沿用本项目既定方向：深墨绿底 + 荧光青绿状态色 + 等宽字体（仪器面板感） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1214">

    <!-- 顶部：设备自检摘要 -->
    <TextView
        android:id="@+id/tvDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B3D2E"
        android:padding="10dp"
        android:textColor="#9BFFD0"
        android:textSize="11sp"
        android:typeface="monospace"
        android:text="" />

    <!-- 日志区 -->
    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0F1214"
        android:scrollbars="vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="#C8E6D6"
            android:textSize="10sp"
            android:typeface="monospace"
            android:textIsSelectable="true"
            android:text="" />
    </ScrollView>

    <!-- 底部操作条：两行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#16211C"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <Button
                android:id="@+id/btnSelfCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:textSize="12sp"
                android:text="重新自检" />

            <Button
                android:id="@+id/btnHeartbeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:textSize="12sp"
                android:text="心跳 开" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:textSize="12sp"
                android:text="清空" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <Button
                android:id="@+id/btnExport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:textSize="12sp"
                android:text="导出日志" />

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:textSize="12sp"
                android:text="复制全部" />

            <Button
                android:id="@+id/btnLogPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:textSize="12sp"
                android:text="日志路径" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
